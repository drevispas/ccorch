{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "types": ["node", "jest"],
    "paths": {
      "@core/*": ["./core/*"],
      "@server/*": ["./server/*"],
      "@schemas/*": ["./server/schemas/*"],
      "@middleware/*": ["./server/middleware/*"],
      "@routes/*": ["./server/routes/*"],
      "@utils/*": ["./server/utils/*"],
      "@types/*": ["./server/types/*"],
      "@client/*": ["./server/client/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "core/**/*",
    "server/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}