{
  "name": "parallel-processing-workflow",
  "version": "1.0.0",
  "description": "Demonstrates parallel task execution for improved performance",
  "metadata": {
    "author": "orchestrator-v2",
    "created": "2024-01-01",
    "tags": ["example", "parallel", "performance"]
  },
  "pipeline": [
    {
      "id": "data-prep",
      "type": "task",
      "name": "Prepare Data",
      "agentName": "backend-architect",
      "complexity": "simple",
      "params": {
        "action": "prepare",
        "format": "json"
      }
    },
    {
      "id": "parallel-analysis",
      "type": "parallel",
      "name": "Parallel Analysis Stage",
      "stages": [
        {
          "id": "code-analysis",
          "type": "task",
          "name": "Analyze Code Quality",
          "agentName": "code-reviewer",
          "complexity": "moderate",
          "params": {
            "metrics": ["complexity", "coverage", "duplication"]
          }
        },
        {
          "id": "security-scan",
          "type": "task",
          "name": "Security Vulnerability Scan",
          "agentName": "issue-detective",
          "complexity": "complex",
          "params": {
            "scanType": "comprehensive",
            "includeDepencies": true
          }
        },
        {
          "id": "performance-test",
          "type": "task",
          "name": "Performance Testing",
          "agentName": "e2e-test-architect",
          "complexity": "moderate",
          "params": {
            "testSuite": "performance",
            "iterations": 100
          }
        }
      ],
      "maxConcurrency": 3
    },
    {
      "id": "aggregate-results",
      "type": "task",
      "name": "Aggregate Analysis Results",
      "agentName": "backend-architect",
      "complexity": "simple",
      "params": {
        "action": "aggregate",
        "generateReport": true
      }
    }
  ],
  "errorHandling": {
    "strategy": "continue",
    "onError": "log",
    "collectErrors": true
  },
  "timeouts": {
    "global": 600000,
    "perTask": 120000
  },
  "monitoring": {
    "metrics": true,
    "tracing": true,
    "logLevel": "info"
  }
}