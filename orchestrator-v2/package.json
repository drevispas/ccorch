{
  "name": "orchestrator-v2",
  "version": "2.0.0",
  "description": "Next-generation orchestrator with EventDrivenStateManager and CQRS pattern",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "npm run build && npm run test",
    "test:all": "jest --forceExit",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch server/index.ts",
    "start": "node dist/index.js",
    "server": "node dist/server/index.js",
    "server:dev": "tsx watch server/index.ts",
    "openapi:generate": "tsx server/utils/openapi-generator.ts",
    "client:build": "tsc -p tsconfig.client.json",
    "test:phase1": "jest tests/state/event-driven-state-manager.test.ts tests/state/event-bus.test.ts tests/server/api.test.ts tests/plugins/plugin-system.test.ts --verbose",
    "test:phase2": "jest tests/workflow/ tests/execution/ tests/integration/ --verbose --passWithNoTests",
    "test:phase3": "jest tests/monitoring/ tests/resilience/ --verbose --passWithNoTests",
    "test:phase4": "jest tests/testing/ tests/migration/ --verbose --passWithNoTests",
    "check:phase1": "./scripts/test-phase-1.sh",
    "check:phase2-prereq": "./scripts/check-prerequisites-phase-2.sh",
    "check:phase3-prereq": "./scripts/check-prerequisites-phase-3.sh",
    "check:phase4-prereq": "./scripts/check-prerequisites-phase-4.sh",
    "session:start": "./start-session.sh"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^6.4.0",
    "@types/ws": "^8.18.1",
    "axios": "^1.6.7",
    "better-sqlite3": "^9.4.1",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "eventemitter3": "^5.0.1",
    "express": "^4.18.3",
    "node-fetch": "^2.7.0",
    "redis": "^4.6.13",
    "rxjs": "^7.8.1",
    "semver": "^7.7.2",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.17",
    "@types/semver": "^7.7.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
