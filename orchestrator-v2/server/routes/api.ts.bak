import { Router, Response } from 'express';
import { z } from 'zod';
import {
  ValidatedRequest,
  validateRequestBody,
  validateRequestParams,
  sendValidatedResponse
} from '../middleware/validation';
import {
  WorkflowIdSchema,
  TaskIdSchema,
  AgentType,
  TaskStatus
} from '../schemas/common';
import {
  AgentResultRequestSchema,
  NextTodoResponseSchema,
  NextTaskResponseSchema,
  AgentResultResponseSchema,
  WorkflowStatusResponseSchema,
  WorkflowsListResponseSchema,
  HealthCheckResponseSchema,
  DebugWorkflowsResponseSchema,
  DebugWorkflowDetailResponseSchema,
  DebugTaskResponseSchema,
  RecoverWorkflowResponseSchema,
  ResetTaskResponseSchema
} from '../schemas/api';
import { ServerState, PendingTask, WorkflowState } from '../types';
import { ServerLogger, LogLevel } from '../utils/logger';
import { ResultFileManager } from '../../core/result-file-manager';
import { HandoverChain } from '../../core/handover-chain';
import { EventDrivenStateManager } from '../../core/state/event-driven-state-manager';
import { WorkflowStatus } from '../../core/state/types';
import { ResponseStatus } from '../../core/enums';

export function createApiRoutes(
  serverState: ServerState,
  serverLogger: ServerLogger | null,
  resultFileManager: ResultFileManager | null,
  handoverChain: HandoverChain | null,
  stateManager: EventDrivenStateManager | null,
  orchestratorInstance: any,
  workflowLoader: any,
  AGENT_EXECUTION_TIMEOUT: number
) {
  const router = Router();

  // Helper function to get next pending task
  async function getNextPendingTask(workflowId: string): Promise<{
    taskId: string;
    params: any;
    timestamp: string;
  } | null> {
    for (const [taskId, task] of serverState.pendingTasks) {
      if (task.workflowId === workflowId &&
          (task.status === 'pending' || task.status === ResponseStatus.AWAITING_CLAUDE_EXECUTION)) {
        return {
          taskId,
          params: task.params,
          timestamp: task.timestamp
        };
      }
    }
    return null;
  }

  // Helper function to create next task in sequence
  async function createNextTaskInSequence(
    workflowId: string,
    workflow: WorkflowState,
    completedAgentType: AgentType
  ): Promise<void> {
    try {
      const existingPendingTask = await getNextPendingTask(workflowId);
      if (existingPendingTask) {
        serverLogger?.logWithContext('warn', 'WORKFLOW', `Next task already exists for workflow ${workflowId}`, {
          taskId: existingPendingTask.taskId
        });
        return;
      }

      if (!workflowLoader) return;

      const workflowDefinition = await workflowLoader.loadWorkflow(workflow.workflowType);
      const sequence = workflowDefinition.agents.sequence;

      const currentAgentIndex = sequence.findIndex((agent: any) => agent.name === completedAgentType);
      if (currentAgentIndex === -1) {
        serverLogger?.logWithContext('warn', 'WORKFLOW', `Completed agent ${completedAgentType} not found in workflow sequence`);
        return;
      }

      const nextAgentIndex = currentAgentIndex + 1;
      if (nextAgentIndex >= sequence.length) {
        serverLogger?.workflowCompleted(workflowId as any, Date.now() - new Date(workflow.startTime).getTime());
        workflow.status = ResponseStatus.COMPLETED as any;
        workflow.endTime = new Date().toISOString();
        serverState.activeWorkflows.set(workflowId, workflow);

        if (stateManager) {
          await stateManager.updateWorkflowStatus(workflowId, WorkflowStatus.COMPLETED);
        }

        if (serverState.currentWorkflowId === workflowId) {
          serverState.currentWorkflowId = null;
        }
        return;
      }

      const nextAgent = sequence[nextAgentIndex];
      const taskId = `task_${Date.now()}_${Math.random().toString(36).slice(2)}` as any;

      const taskParams = {
        subagent_type: nextAgent.name as AgentType,
        description: `Execute ${nextAgent.name} for workflow step ${nextAgentIndex + 1}`,
        prompt: workflow.taskDescription,
        projectDirectory: workflow.projectDirectory,
        complexity: workflow.complexity
      };

      serverState.pendingTasks.set(taskId, {
        workflowId: workflowId as any,
        params: taskParams,
        timestamp: new Date().toISOString(),
        status: ResponseStatus.AWAITING_CLAUDE_EXECUTION as any,
        promise: null,
        timeoutId: null
      });

      workflow.pendingTaskId = taskId;
      serverState.activeWorkflows.set(workflowId, workflow);

      serverState.taskNotifier.emit('taskReady', {
        taskId,
        workflowId,
        agentType: nextAgent.name
      });

      const timeoutObj = setTimeout(() => {
        const task = serverState.pendingTasks.get(taskId);
        if (task && (task.status === ResponseStatus.AWAITING_CLAUDE_EXECUTION || task.status === 'claude_executing')) {
          serverLogger?.logWithContext('warn', 'TASK', `Task timed out`, {
            taskId,
            agentName: nextAgent.name,
            duration: AGENT_EXECUTION_TIMEOUT
          });
          task.status = 'timeout';
          serverState.pendingTasks.set(taskId, task);
          serverState.taskTimeouts.delete(taskId);
        }
      }, AGENT_EXECUTION_TIMEOUT);

      serverState.taskTimeouts.set(taskId, timeoutObj);
    } catch (error) {
      serverLogger?.logWithContext('error', 'WORKFLOW', `Failed to create next task: ${error instanceof Error ? error.message : 'Unknown error'}`);
    }
  }

  // GET /api/next-todo/:workflowId
  router.get('/next-todo/:workflowId',
    validateRequestParams(z.object({ workflowId: WorkflowIdSchema })),
    async (req: ValidatedRequest<any, { workflowId: string }>, res: Response) => {
      const { workflowId } = req.validatedParams!;
      const todos = serverState.pendingTodos.get(workflowId) || [];

      if (todos.length > 0) {
        const nextTodo = todos.find(todo =>
          todo.status === 'pending' || todo.status === 'in_progress'
        );

        if (nextTodo) {
          serverLogger?.logWithContext('info', 'WORKFLOW', `Retrieved next todo for workflow ${workflowId}: ${nextTodo.content}`);
          const response = {
            todo: nextTodo,
            allTodos: todos,
            workflowId: workflowId as any
          };
          return sendValidatedResponse(res, NextTodoResponseSchema, response, serverLogger, req.correlationId);
        }

        const response = {
          todo: null,
          message: 'All todos completed',
          allTodos: todos,
          workflowId: workflowId as any
        };
        return sendValidatedResponse(res, NextTodoResponseSchema, response, serverLogger, req.correlationId);
      }

      const response = {
        todo: null,
        message: 'No todos available',
        allTodos: [],
        workflowId: workflowId as any
      };
      sendValidatedResponse(res, NextTodoResponseSchema, response, serverLogger, req.correlationId);
    }
  );

  // GET /api/next-task/:workflowId
  router.get('/next-task/:workflowId',
    validateRequestParams(z.object({ workflowId: WorkflowIdSchema })),
    async (req: ValidatedRequest<any, { workflowId: string }>, res: Response) => {
      const { workflowId } = req.validatedParams!;

      for (const [taskId, task] of serverState.pendingTasks) {
        if (task.workflowId === workflowId &&
            (task.status === 'pending' || task.status === 'awaiting_claude_execution')) {
          serverLogger?.logWithContext('info', 'TASK', `Task found: ${task.params.subagent_type} | workflow: ${workflowId}`);

          if (task.status === 'awaiting_claude_execution') {
            task.status = 'claude_executing';
            serverState.pendingTasks.set(taskId, task);
          }

          const workflow = serverState.activeWorkflows.get(workflowId);
          const projectDirectory = workflow?.projectDirectory || process.cwd();
          const complexity = workflow?.complexity || 'moderate';

          if (!workflow?.complexity && serverLogger) {
            serverLogger.logWithContext('warn', 'WORKFLOW', `Missing complexity in workflow metadata, using moderate fallback`, {
              workflowId
            });
          }

          const response = {
            taskId: taskId as any,
            params: {
              ...task.params,
              projectDirectory,
              complexity
            },
            timestamp: task.timestamp
          };

          return sendValidatedResponse(res, NextTaskResponseSchema, response, serverLogger, req.correlationId);
        }
      }

      serverLogger?.logWithContext('warn', 'TASK', `No pending tasks found for workflow ${workflowId}`);
      const response = {
        taskId: null,
        message: 'No pending tasks'
      };
      sendValidatedResponse(res, NextTaskResponseSchema, response, serverLogger, req.correlationId);
    }
  );

  // POST /api/agent-result
  router.post('/agent-result',
    validateRequestBody(AgentResultRequestSchema),
    async (req: ValidatedRequest<z.infer<typeof AgentResultRequestSchema>>, res: Response) => {
      try {
        const { taskId, result, success = true, agentType } = req.validatedBody!;

        const task = serverState.pendingTasks.get(taskId);
        if (!task) {
          return res.status(404).json({ error: 'Task not found' });
        }

        serverLogger?.taskResultReceived(taskId, (agentType || task.params.subagent_type) as AgentType, success);

        // Clear timeout if it exists
        if (task.timeoutId && serverState.taskTimeouts.has(taskId)) {
          clearTimeout(serverState.taskTimeouts.get(taskId));
          serverState.taskTimeouts.delete(taskId);
        }

        // Update task status
        task.status = 'completed';
        task.result = result;
        task.success = success;
        task.completedTime = new Date().toISOString();
        serverState.pendingTasks.set(taskId, task);

        // Save result asynchronously
        if (success && resultFileManager && handoverChain) {
          setImmediate(async () => {
            try {
              const workflow = serverState.activeWorkflows.get(task.workflowId);
              const stepIndex = workflow ? workflow.completedTasks.length : 0;

              const [createDirResult, structuredResult] = await Promise.all([
                resultFileManager.createWorkflowDirectory(task.workflowId),
                Promise.resolve(resultFileManager.convertLegacyResult(
                  task.workflowId,
                  stepIndex,
                  agentType || task.params?.subagent_type,
                  { result, success },
                  task.params?.description || 'Agent execution completed'
                ))
              ]);

              const [resultPaths, previousResults] = await Promise.all([
                resultFileManager.writeAgentResult(
                  task.workflowId,
                  stepIndex,
                  agentType || task.params?.subagent_type,
                  structuredResult
                ),
                resultFileManager.readPreviousResults(task.workflowId, stepIndex + 1)
              ]);

              serverLogger?.logWithContext('info', 'TASK', `Agent result saved to: ${resultPaths.resultDir}`);

              if (previousResults.length > 0) {
                await handoverChain.createHandoverFromResults(
                  task.workflowId,
                  agentType || task.params?.subagent_type,
                  stepIndex + 1,
                  previousResults
                );
                serverLogger?.logWithContext('info', 'WORKFLOW', 'Created handover documents for next agent');
              }
            } catch (error) {
              serverLogger?.logWithContext('error', 'TASK', `Failed to save agent result: ${error instanceof Error ? error.message : 'Unknown error'}`);
            }
          });
        }

        // Legacy promise resolution
        if (task.promise && task.promise.resolve) {
          if (success) {
            task.promise.resolve(result);
          } else {
            task.promise.reject(new Error(`Task failed: ${result}`));
          }
        }

        // Update workflow state
        const workflow = serverState.activeWorkflows.get(task.workflowId);
        if (workflow) {
          workflow.completedTasks.push({
            taskId: taskId as any,
            agentType: (agentType || task.params?.subagent_type) as AgentType,
            success,
            completedAt: new Date().toISOString()
          });

          if (workflow.pendingTaskId === taskId) {
            workflow.pendingTaskId = null;
          }

          serverState.activeWorkflows.set(task.workflowId, workflow);

          // Update workflow state file
          if (orchestratorInstance) {
            try {
              const stepIndex = workflow.completedTasks.length - 1;
              await orchestratorInstance.stateManager.updateStepState(task.workflowId, stepIndex, {
                agentName: agentType || task.params?.subagent_type,
                status: success ? ResponseStatus.COMPLETED : ResponseStatus.FAILED,
                startTime: task.createdTime || new Date().toISOString(),
                endTime: task.completedTime
              });
              serverLogger?.logWithContext('info', 'WORKFLOW', `Updated workflow state file for ${task.workflowId}, step ${stepIndex}`);
            } catch (error) {
              serverLogger?.logWithContext('error', 'WORKFLOW', `Failed to update workflow state: ${error instanceof Error ? error.message : 'Unknown error'}`);
            }
          }

          // Create next task in sequence
          if (success) {
            await createNextTaskInSequence(task.workflowId, workflow, (agentType || task.params?.subagent_type) as AgentType);
          }
        }

        const nextPendingTask = await getNextPendingTask(task.workflowId);

        const response = {
          status: ResponseStatus.RECEIVED,
          taskId: taskId as any,
          success,
          workflowId: task.workflowId,
          nextTask: nextPendingTask
        };

        sendValidatedResponse(res, AgentResultResponseSchema, response, serverLogger, req.correlationId);
      } catch (error) {
        serverLogger?.logWithContext('error', 'SERVER', `Failed to process agent result: ${error instanceof Error ? error.message : 'Unknown error'}`);
        res.status(500).json({
          error: 'Failed to process agent result',
          details: error instanceof Error ? error.message : 'Unknown error',
          correlationId: req.correlationId
        });
      }
    }
  );

  // GET /api/status/:workflowId
  router.get('/status/:workflowId',
    validateRequestParams(z.object({ workflowId: WorkflowIdSchema })),
    async (req: ValidatedRequest<any, { workflowId: string }>, res: Response) => {
      const { workflowId } = req.validatedParams!;
      const workflow = serverState.activeWorkflows.get(workflowId);

      if (workflow) {
        const pendingTasksCount = Array.from(serverState.pendingTasks.values())
          .filter(task => task.workflowId === workflowId &&
                         (task.status === 'pending' || task.status === ResponseStatus.AWAITING_CLAUDE_EXECUTION)).length;

        const response = {
          ...workflow,
          pendingTasks: pendingTasksCount,
          hasPendingTodos: serverState.pendingTodos.has(workflowId)
        };

        sendValidatedResponse(res, WorkflowStatusResponseSchema, response, serverLogger, req.correlationId);
      } else {
        res.status(404).json({ error: 'Workflow not found' });
      }
    }
  );

  // GET /api/workflows
  router.get('/workflows', async (req: ValidatedRequest, res: Response) => {
    const workflows = Array.from(serverState.activeWorkflows.entries()).map(([id, workflow]) => ({
      workflowId: id as any,
      ...workflow
    }));

    const response = { workflows };
    sendValidatedResponse(res, WorkflowsListResponseSchema, response, serverLogger, req.correlationId);
  });

  // GET /api/health
  router.get('/health', async (req: ValidatedRequest, res: Response) => {
    const response = {
      status: ResponseStatus.HEALTHY,
      initialized: orchestratorInstance !== null,
      activeWorkflows: serverState.activeWorkflows.size,
      pendingTasks: serverState.pendingTasks.size,
      pendingTodos: serverState.pendingTodos.size,
      currentWorkflowId: serverState.currentWorkflowId as any,
      timestamp: new Date().toISOString()
    };

    sendValidatedResponse(res, HealthCheckResponseSchema, response, serverLogger, req.correlationId);
  });

  // Debug endpoints
  router.get('/debug/workflows', async (req: ValidatedRequest, res: Response) => {
    const cleanPendingTasks = Array.from(serverState.pendingTasks.entries()).map(([taskId, task]) => {
      const { promise, timeoutId, ...cleanTask } = task;
      return [taskId, {
        ...cleanTask,
        hasPromise: !!promise,
        hasTimeout: !!timeoutId && serverState.taskTimeouts.has(taskId)
      }];
    });

    const response = {
      active: Array.from(serverState.activeWorkflows.entries()) as any,
      pendingTodos: Array.from(serverState.pendingTodos.entries()) as any,
      pendingTasks: cleanPendingTasks as any,
      currentWorkflowId: serverState.currentWorkflowId as any,
      timestamp: new Date().toISOString()
    };

    sendValidatedResponse(res, DebugWorkflowsResponseSchema, response, serverLogger, req.correlationId);
  });

  // Recovery endpoints
  router.post('/recover-workflow/:workflowId',
    validateRequestParams(z.object({ workflowId: WorkflowIdSchema })),
    async (req: ValidatedRequest<any, { workflowId: string }>, res: Response) => {
      try {
        const { workflowId } = req.validatedParams!;
        const workflow = serverState.activeWorkflows.get(workflowId);

        if (!workflow) {
          return res.status(404).json({ error: 'Workflow not found' });
        }

        const lastCompletedAgent = workflow.completedTasks.length > 0 ?
          workflow.completedTasks[workflow.completedTasks.length - 1].agentType : undefined;

        if (lastCompletedAgent) {
          await createNextTaskInSequence(workflowId, workflow, lastCompletedAgent);
          const response = {
            success: true,
            message: 'Attempted to create next task in sequence',
            lastCompletedAgent
          };
          sendValidatedResponse(res, RecoverWorkflowResponseSchema, response, serverLogger, req.correlationId);
        } else {
          const response = {
            success: false,
            message: 'No completed tasks found - workflow may need restart'
          };
          sendValidatedResponse(res, RecoverWorkflowResponseSchema, response, serverLogger, req.correlationId);
        }
      } catch (error) {
        serverLogger?.logWithContext('error', 'RECOVERY', `Failed to recover workflow: ${error instanceof Error ? error.message : 'Unknown error'}`);
        res.status(500).json({
          error: 'Recovery failed',
          details: error instanceof Error ? error.message : 'Unknown error',
          correlationId: req.correlationId
        });
      }
    }
  );

  router.post('/reset-task/:taskId',
    validateRequestParams(z.object({ taskId: TaskIdSchema })),
    async (req: ValidatedRequest<any, { taskId: string }>, res: Response) => {
      try {
        const { taskId } = req.validatedParams!;
        const task = serverState.pendingTasks.get(taskId);

        if (!task) {
          return res.status(404).json({ error: 'Task not found' });
        }

        if (serverState.taskTimeouts.has(taskId)) {
          clearTimeout(serverState.taskTimeouts.get(taskId));
          serverState.taskTimeouts.delete(taskId);
        }

        task.status = 'awaiting_claude_execution';
        task.resetTime = new Date().toISOString();
        serverState.pendingTasks.set(taskId, task);

        const response = {
          success: true,
          message: 'Task reset to awaiting execution',
          taskId: taskId as any,
          agentType: task.params.subagent_type as AgentType
        };

        sendValidatedResponse(res, ResetTaskResponseSchema, response, serverLogger, req.correlationId);
      } catch (error) {
        serverLogger?.logWithContext('error', 'RECOVERY', `Failed to reset task: ${error instanceof Error ? error.message : 'Unknown error'}`);
        res.status(500).json({
          error: 'Reset failed',
          details: error instanceof Error ? error.message : 'Unknown error',
          correlationId: req.correlationId
        });
      }
    }
  );

  return router;
}