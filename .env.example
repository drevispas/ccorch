# =============================================================================
# Claude Code Orchestrator - Environment Configuration Example
# =============================================================================
# Copy this file to .env and update values for your environment
# DO NOT commit .env to version control (it's in .gitignore)

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Port number for the HTTP server
# Default: 3000
PORT=3000

# Node environment (development, production, test)
# Affects logging levels and error handling
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# SQLite database file path (relative to project root)
# For production with Redis: redis://localhost:6379
DATABASE_URL=file:./dev.db

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Logging level (debug, info, warn, error)
# development: info or debug
# production: warn or error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------

# API key for admin endpoints (POST /api/workflows/:id/transition)
# IMPORTANT: Generate a secure random key for production
# Example generation: openssl rand -base64 32
API_KEY_ADMIN=changeme-generate-secure-key-in-production

# Shared secret for hook authentication
# Used to verify requests from Claude Code hooks
# IMPORTANT: Must match the secret configured in .claude/settings.json
# Example generation: openssl rand -base64 32
HOOK_SECRET=changeme-shared-secret-for-hook-auth
